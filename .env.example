# ============================================
# LOCAL DEVELOPMENT (.env.local)
# Run: cp .env.example .env.local && npm run dev
# Uses local Docker infrastructure
# ============================================

# General
NODE_ENV=development
LOG_LEVEL=info

# Database (local Docker)
DATABASE_URL=postgres://scan_user:scan_password@localhost:5432/scan_prices
DATABASE_SSL=false

# Production (Supabase) - MUST be true
# DATABASE_SSL=true

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Web (Vite)
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:4000

# Worker
WORKER_CONCURRENCY=5

# FX (exchange rate)
FX_BASE_CURRENCY=USD
FX_TARGET_CURRENCY=VES
FX_PROVIDER=bcv
FX_FALLBACK_RATE=92.5
FX_ADMIN_KEY=dev-admin-key